<?xml version="1.0" encoding="utf-8"?><!--
   Verb's app-private storage holds an on-device Linux userland (proot rootfs, shell history, and
   any credentials the user configures inside the terminal). It must not leave the device via Auto
   Backup or device transfer, so app files are excluded rather than left to the sample defaults.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
