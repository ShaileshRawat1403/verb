<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      The V, which is the shell prompt stood upright.

      The icon used to draw the prompt lying down ('>') beside an underscore. It is the same idea
      turned a quarter turn, so the launcher and the wordmark in assets/brand are now one mark
      rather than two things that happen to share a palette.

      Drawn inside the 72dp adaptive-icon safe zone (18..90), mitred and flat-ended: a character
      cell has corners, so the mark does not get rounded joins.
    -->
    <path
        android:strokeColor="#6366F1"
        android:strokeWidth="9"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:pathData="M36,38 L54,66 L72,38" />
    <!-- The cursor, waiting for input. -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M66,70 L84,70 L84,78 L66,78 Z" />
</vector>
