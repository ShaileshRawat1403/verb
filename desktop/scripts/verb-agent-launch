#!/bin/bash
# Fixed sudo target, run as verb-agent, never root. No terminal or credential logging.
set -euo pipefail
fail() { echo "agent isolation: $*" >&2; exit 126; }
config=/etc/verb/agent-launch.conf
[[ $(stat -c %u /etc/verb) == 0 && ! -L /etc/verb ]] || fail 'untrusted configuration directory'
directory_permissions=$(stat -c %a /etc/verb)
(( (8#$directory_permissions & 8#022) == 0 )) || fail 'configuration directory is writable by others'
[[ $(id -u) != 0 && $(id -un) == verb-agent ]] || fail 'wrong execution account'
[[ $(stat -c %u "$config") == 0 && ! -L "$config" ]] || fail 'configuration is not root-owned'
permissions=$(stat -c %a "$config")
(( (8#$permissions & 8#022) == 0 )) || fail 'configuration is writable by others'
. "$config"
: "${AGENT_HOME:?}" "${WORKSPACE_ROOT:?}" "${AGENT_CGROUP:?}"
if [[ ${1:-} == --signal ]]; then
  [[ $# == 3 && "$2" =~ ^[1-9][0-9]*$ && "$2" != 1 ]] || fail 'invalid session signal'
  case "$3" in HUP|TERM|KILL) ;; *) fail 'invalid signal' ;; esac
  wanted=$2; signal=$3; me=$(id -u)
  while read -r pid sid uid; do
    if [[ "$sid" == "$wanted" && "$uid" == "$me" ]]; then
      kill -s "$signal" -- "$pid" 2>/dev/null || true
    fi
  done < <(/usr/bin/ps -eo pid=,sid=,uid=)
  exit 0
fi
[[ $# -ge 3 ]] || fail 'usage: PROJECT SESSION [--env KEY VALUE] -- PROGRAM ARGS'
project=$(realpath -e -- "$1") || fail 'missing project'
session=$2; shift 2
[[ "$project" == "$WORKSPACE_ROOT" || "$project" == "$WORKSPACE_ROOT/"* ]] || fail 'project outside workspace root'
[[ "$session" =~ ^[a-zA-Z0-9_-]*$ && ${#session} -le 128 ]] || fail 'invalid session identity'
extra=()
while [[ ${1:-} == --env ]]; do
  [[ $# -ge 3 ]] || fail 'incomplete environment override'
  case "$2" in
    ZDOTDIR|VERB_SHELL_DIR) [[ "$3" == /var/lib/verb-shell || "$3" == /var/lib/verb-shell/* ]] || fail 'invalid shell integration directory' ;;
    VERB_ZDOTDIR_ORIGINAL) [[ "$3" == "$AGENT_HOME" ]] || fail 'invalid agent home' ;;
    RUSTUP_AUTO_INSTALL) [[ "$3" == 0 ]] || fail 'runtime downloads are disabled' ;;
    GOTOOLCHAIN) [[ "$3" == local ]] || fail 'runtime downloads are disabled' ;;
    *) fail 'environment override is not allowed' ;;
  esac
  extra+=("$2=$3"); shift 3
done
[[ ${1:-} == -- && $# -ge 2 ]] || fail 'missing program'; shift
filesystem=$(stat -f -c %T "$AGENT_CGROUP")
case "$filesystem" in
  cgroup2fs) limit="$AGENT_CGROUP/memory.max" ;;
  cgroupfs|cgroup) limit="$AGENT_CGROUP/memory.limit_in_bytes" ;;
  *) fail 'memory cgroup is unavailable' ;;
esac
[[ $(stat -c %u "$AGENT_CGROUP") == 0 && ! -L "$AGENT_CGROUP" ]] || fail 'untrusted cgroup'
budget=$(cat "$limit")
[[ ! -w "$limit" && ! -w "$AGENT_CGROUP" ]] || fail 'agent can change the memory policy'
[[ "$budget" =~ ^[0-9]+$ ]] || fail 'memory budget is unlimited'
awk -v n="$budget" 'BEGIN { exit !(n > 0 && n <= 8589934592) }' || fail 'invalid memory budget'
# Inherited membership is sufficient, including on a read-only delegated controller.
if ! grep -qx "$$" "$AGENT_CGROUP/cgroup.procs"; then
  echo "$$" > "$AGENT_CGROUP/cgroup.procs" || fail 'cannot join memory cgroup'
fi
grep -qx "$$" "$AGENT_CGROUP/cgroup.procs" || fail 'memory membership not established'
awk '/^Cap(Eff|Prm):/ { if ($2 !~ /^0+$/) exit 1 }' /proc/self/status || fail 'privileged capabilities remain'
[[ " $(id -G) " != *' 0 '* ]] || fail 'root group retained'
[[ " $(id -G) " != *' 3004 '* ]] || fail 'raw-network group retained'
# A finite memcg limit does not constrain Android tasks with inherited OOM immunity.
# Root must reset the service chain before dropping privileges. Probe only a child.
[[ $(cat /proc/self/oom_score_adj) == 0 ]] || fail 'OOM protection must be reset by the service'
if (printf '%s' -1 > /proc/self/oom_score_adj) 2>/dev/null; then
  fail 'agent can restore OOM protection'
fi
ulimit -c 0
cd -- "$project"
exec /usr/bin/setpriv --no-new-privs --inh-caps=-all --ambient-caps=-all \
  /usr/bin/env -i HOME="$AGENT_HOME" USER=verb-agent LOGNAME=verb-agent \
  PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TERM=xterm-256color COLORTERM=truecolor \
  PWD="$project" VERB_SESSION_ID="$session" VERB_PROJECT_ROOT="$project" \
  VERB_BIN=/usr/local/bin/verb \
  GIT_TERMINAL_PROMPT=0 GIT_OPTIONAL_LOCKS=0 RUSTUP_AUTO_INSTALL=0 GOTOOLCHAIN=local \
  "${extra[@]}" "$@"
